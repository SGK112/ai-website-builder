# ===========================================
# WebStew AI Website Builder - Environment Variables
# ===========================================

# App Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# ===========================================
# REQUIRED: Database
# ===========================================
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/webstew

# ===========================================
# REQUIRED: Authentication (at least one)
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (optional)
GITHUB_ID=your-github-id
GITHUB_SECRET=your-github-secret

# ===========================================
# AI PROVIDERS (at least one required)
# ===========================================

# Free Tier AI (HuggingFace - recommended for free users)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# Premium AI Providers
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Alternative Free Providers
TOGETHER_API_KEY=your-together-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-token
GOOGLE_AI_API_KEY=your-google-ai-key

# ===========================================
# IMAGE SERVICES (for stock photos)
# ===========================================
PIXABAY_API_KEY=your-pixabay-key
PEXELS_API_KEY=your-pexels-key
UNSPLASH_ACCESS_KEY=your-unsplash-key
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your-unsplash-key

# ===========================================
# OPTIONAL: Deployment Services
# ===========================================
RENDER_API_KEY=your-render-api-key
GITHUB_ACCESS_TOKEN=your-github-pat

# ===========================================
# OPTIONAL: File Storage
# ===========================================
# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Supabase (alternative storage)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# OPTIONAL: Payments (Stripe)
# ===========================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxxxxxxxx

# ===========================================
# OPTIONAL: Email (SendGrid)
# ===========================================
SENDGRID_API_KEY=SG.xxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# ===========================================
# OPTIONAL: Security
# ===========================================
ENCRYPTION_KEY=32-character-encryption-key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret
INTERNAL_API_KEY=your-internal-api-key

# ===========================================
# OPTIONAL: Advanced AI (RunPod GPU Endpoints)
# ===========================================
RUNPOD_API_KEY=your-runpod-key
RUNPOD_FLUX_ENDPOINT=your-flux-endpoint-id
RUNPOD_SDXL_ENDPOINT=your-sdxl-endpoint-id
RUNPOD_TTS_ENDPOINT=your-tts-endpoint-id

# Replicate (AI model hosting)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# OPTIONAL: Cron Jobs (for endpoint warm-up)
# ===========================================
# Secret for authenticating cron requests
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ===========================================
# OPTIONAL: Sentry error monitoring
# ===========================================
# Get DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
# When unset, all Sentry code paths no-op (safe for local dev).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
# Only required in CI for source-map upload. Without it, errors still ship
# but stack traces won't be source-mapped.
SENTRY_AUTH_TOKEN=

# ===========================================
# OPTIONAL: Abuse-guard manual blocklists
# ===========================================
# See lib/abuse-guard.ts. Comma-separated lists; rotate without redeploy.
BLOCKED_IPS=
# Only meaningful behind Cloudflare with cf-asn (paid CF tiers).
BLOCKED_ASNS=
